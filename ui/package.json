    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/merge": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@vscode/markdown-it-katex": "^1.1.2",
